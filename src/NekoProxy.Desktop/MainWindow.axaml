<Window xmlns="https://github.com/avaloniaui" xmlns:l="using:NekoProxy.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NekoProxy.Desktop.ViewModels" xmlns:controls="using:NekoProxy.Desktop.Controls" xmlns:views="using:NekoProxy.Desktop.Views" x:Class="NekoProxy.Desktop.MainWindow" x:DataType="vm:MainViewModel" Title="NekoProxy" Width="1060" Height="720" MinWidth="900" MinHeight="600" SystemDecorations="Full" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="42" TransparencyLevelHint="AcrylicBlur, Blur, None" TransparencyBackgroundFallback="#EAF2FB" Background="Transparent" Classes.reduced="{Binding Settings.ReduceMotion}" Classes.simpleGlass="{Binding Settings.SimplifiedVisuals}" WindowStartupLocation="CenterScreen">
  <Window.Styles><Style Selector="Border.toastAccent"><Setter Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/></Style><Style Selector="Border.toastAccent.error"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/></Style><Style Selector="TextBlock.toastTitle"><Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/></Style><Style Selector="TextBlock.toastTitle.error"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style></Window.Styles>
  <Grid x:Name="WindowScene" RowDefinitions="42,*,28" Background="Transparent"><controls:GlassSurface Grid.RowSpan="3" Simplified="{Binding Settings.SimplifiedVisuals}" IsHitTestVisible="False"/>
    <controls:GlassPanel Grid.Row="0" CornerRadius="0" BoxShadow="0 0 0 0 Transparent"><Grid ColumnDefinitions="Auto,*" Margin="12,0,0,0">
      <StackPanel x:Name="TitlebarTrafficControls" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button x:Name="CloseWindowButton" Classes="traffic close" Click="CloseClicked" ToolTip.Tip="{l:Tr a066}" AutomationProperties.Name="{l:Tr a066}"><Ellipse Width="12" Height="12" Fill="#EC827E"/></Button>
        <Button x:Name="MinimizeWindowButton" Classes="traffic" Click="MinimizeClicked" ToolTip.Tip="{l:Tr a168}" AutomationProperties.Name="{l:Tr a168}"><Ellipse Width="12" Height="12" Fill="#E9C267"/></Button>
        <Button x:Name="MaximizeWindowButton" Classes="traffic" Click="MaximizeClicked" ToolTip.Tip="{l:Tr a167}" AutomationProperties.Name="{l:Tr a167}"><Ellipse Width="12" Height="12" Fill="#83BA91"/></Button>
      </StackPanel>
      <Border x:Name="TitlebarDragRegion" Grid.Column="1" Background="Transparent" PointerPressed="TitlebarPressed"><TextBlock x:Name="TitlebarText" Text="NekoProxy" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,96,0" TextWrapping="Wrap"/></Border>
    </Grid></controls:GlassPanel>
    <Grid Classes="modalBackdrop" Classes.blurred="{Binding HasModal}" Grid.Row="1" ColumnDefinitions="200,*" IsEnabled="{Binding CanInteractWithMain}">
      <controls:GlassPanel Margin="12,12,4,12" Background="{DynamicResource SidebarBrush}" CornerRadius="20">
        <Grid RowDefinitions="Auto,*,Auto" Margin="12,24,12,20">
          <TextBlock Text="NekoProxy" FontSize="21" FontWeight="SemiBold" Margin="15,0,0,38" TextWrapping="Wrap"/>
          <StackPanel Grid.Row="1" Spacing="8">
            <Button Classes="nav" Classes.selected="{Binding IsDeploy}" AutomationProperties.Name="{l:Tr a293}" Command="{Binding NavigateCommand}" CommandParameter="部署代理"><Grid ColumnDefinitions="18,*"><Path Data="M12 3 L20 11 L12 19 M4 11 H20" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform"/><TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{l:Tr a293}" TextWrapping="Wrap"/></Grid></Button>
            <Button Classes="nav" Classes.selected="{Binding IsManage}" AutomationProperties.Name="{l:Tr a230}" Command="{Binding NavigateCommand}" CommandParameter="管理服务"><Grid ColumnDefinitions="18,*"><Path Data="M3 4 H21 V10 H3 Z M3 14 H21 V20 H3 Z M6 7 H8 M6 17 H8" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/><TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{l:Tr a230}" TextWrapping="Wrap"/></Grid></Button>
            <Button Classes="nav" Classes.selected="{Binding IsAdvanced}" AutomationProperties.Name="{l:Tr a306}" Command="{Binding NavigateCommand}" CommandParameter="高级功能"><Grid ColumnDefinitions="18,*"><Path Data="M3 4 H9 V10 H3 Z M15 4 H21 V10 H15 Z M3 16 H9 V22 H3 Z M15 16 H21 V22 H15 Z" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/><TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{l:Tr a306}" TextWrapping="Wrap"/></Grid></Button>
            <Button Classes="nav" Classes.selected="{Binding IsPrivacy}" AutomationProperties.Name="{l:Tr a152}" Command="{Binding NavigateCommand}" CommandParameter="隐私"><Grid ColumnDefinitions="18,*"><Path Data="M12 2 L21 6 V12 C21 17 17 20 12 22 C7 20 3 17 3 12 V6 Z M8 12 L11 15 L16 9" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/><TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{l:Tr a152}" TextWrapping="Wrap"/></Grid></Button>
            <Button Classes="nav" Classes.selected="{Binding IsSettingsSection}" AutomationProperties.Name="{l:Tr a246}" Command="{Binding NavigateCommand}" CommandParameter="设置"><Grid ColumnDefinitions="18,*"><Path Data="M3 6 H21 M3 12 H21 M3 18 H21 M8 3 V9 M16 9 V15 M10 15 V21" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform"/><TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{l:Tr a246}" TextWrapping="Wrap"/></Grid></Button>
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="7" Margin="15,0,0,0"><TextBlock Text="{l:Tr a035}" Classes="small" TextWrapping="Wrap"/></StackPanel>
        </Grid>
      </controls:GlassPanel>
      <controls:GlassPanel Grid.Column="1" Margin="12,12,16,12" Background="{DynamicResource ContentGlassBrush}" CornerRadius="22" ClipToBounds="True"><controls:PageDeck x:Name="MainPages" Background="Transparent" SelectedIndex="{Binding PageIndex}" ReduceMotion="{Binding Settings.ReduceMotion}">
        <views:DeploymentView DataContext="{Binding Deployment}"/>
        <views:ManageView/>
        <views:AdvancedView DataContext="{Binding Advanced}"/>
        <views:PrivacyView DataContext="{Binding Privacy}"/>
        <views:SettingsView DataContext="{Binding Settings}"/>
      </controls:PageDeck></controls:GlassPanel>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,0"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:Local Status}" FontSize="11.5" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" IsVisible="{Binding Settings.Updates.HasUpdate}" Command="{Binding OpenUpdatesCommand}" Classes="quiet" FontSize="11" MinHeight="24" Padding="8,1"><TextBlock Text="{l:Tr updates.available}" MaxWidth="320" TextTrimming="CharacterEllipsis"/></Button></Grid></Border>
    <controls:RevealBorder Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource DimBrush}" IsShown="{Binding HasEditor}" ReduceMotion="{ReflectionBinding $parent[Window].DataContext.Settings.ReduceMotion}">
      <controls:GlassPanel Background="{DynamicResource DialogGlassBrush}" Width="520" Padding="24" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto" controls:FormAssist.Message="{Binding Editor.Error}"><TextBlock Text="{l:Local Editor.Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/><ScrollViewer Grid.Row="1" MaxHeight="390"><StackPanel Spacing="12">
          <TextBlock Text="{l:Local Editor.Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
          <TextBlock Text="{l:Tr a172}" Classes="small" TextWrapping="Wrap"/><TextBox controls:FormAssist.Field="Name" Text="{Binding Editor.Name}" Watermark="{l:Tr a054}"/>
          <StackPanel IsVisible="{Binding Editor.FullEdit}" Spacing="12">
            <Grid ColumnDefinitions="*,*"><StackPanel Spacing="6" Margin="0,0,10,0"><TextBlock Text="{l:Tr a061}" Classes="small" TextWrapping="Wrap"/><TextBox controls:FormAssist.Field="Host" Text="{Binding Editor.Host}" Watermark="IPv4 / IPv6"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{l:Tr a092}" Classes="small" TextWrapping="Wrap"/><TextBox Text="{Binding Editor.Location}" Watermark="{l:Tr a055}"/></StackPanel></Grid>
            <ComboBox ItemsSource="{Binding Editor.AuthenticationChoices}" SelectedIndex="{Binding Editor.AuthenticationIndex}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{l:Local .}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock IsVisible="{Binding !Editor.IsPassword}" Text="{l:Tr a020}" Classes="small" TextWrapping="Wrap"/><TextBox controls:FormAssist.Field="PrivateKeyPath" IsVisible="{Binding !Editor.IsPassword}" Text="{Binding Editor.PrivateKeyPath}" Watermark="{l:Tr a083}"/>
            <TextBlock Text="{l:Local Editor.LoginSecretLabel}" Classes="small"/><controls:SecretTextBox Text="{Binding Editor.LoginSecret}" PasswordChar="●" Watermark="{l:Tr v052.secretPlaceholder}"/><TextBlock Text="{l:Tr ssh.sessionOnly}" Classes="small" TextWrapping="Wrap"/><TextBox controls:FormAssist.Field="Ipv6Address" Text="{Binding Editor.Ipv6Address}" Watermark="{l:Tr v051.018}"/><Grid ColumnDefinitions="*,*"><StackPanel Spacing="6" Margin="0,0,10,0"><TextBlock Text="{l:Tr a021}" Classes="small" TextWrapping="Wrap"/><TextBox controls:FormAssist.Field="SshPort" Text="{Binding Editor.SshPort}"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{l:Tr a212}" Classes="small" TextWrapping="Wrap"/><TextBox controls:FormAssist.Field="Username" Text="{Binding Editor.Username}"/></StackPanel></Grid>
            <TextBlock Text="{l:Tr a098}" Classes="small" TextWrapping="Wrap"/><TextBox Text="{Binding Editor.Notes}" AcceptsReturn="True" Height="72" TextWrapping="Wrap"/>
            <TextBlock Text="{l:Tr a202}" Classes="small" TextWrapping="Wrap"/>
          </StackPanel>


        </StackPanel></ScrollViewer>          <StackPanel Grid.Row="2" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="{l:Tr a082}" Command="{Binding CancelEditorCommand}"/><Button Content="{l:Tr a060}" Classes="primary" Command="{Binding SaveServerCommand}"/></StackPanel></Grid>
      </controls:GlassPanel>
    </controls:RevealBorder>
    <controls:RevealBorder Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource DimBrush}" IsShown="{Binding IsRemoving}" ReduceMotion="{ReflectionBinding $parent[Window].DataContext.Settings.ReduceMotion}"><Border Width="420" Background="{DynamicResource DialogGlassBrush}" Padding="30" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="18"><TextBlock Text="{l:Tr a223}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{l:Tr a084}" Classes="muted" LineHeight="24" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="{l:Tr a082}" Command="{Binding CancelRemoveCommand}"/><Button Content="{l:Tr a224}" Classes="danger" Command="{Binding ConfirmRemoveCommand}"/></StackPanel></StackPanel></Border></controls:RevealBorder>
    <controls:RevealBorder Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource DimBrush}" IsShown="{Binding HasNodeEditor}" ReduceMotion="{ReflectionBinding $parent[Window].DataContext.Settings.ReduceMotion}"><Border Width="480" Background="{DynamicResource DialogGlassBrush}" Padding="30" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid RowDefinitions="Auto,*,Auto" controls:FormAssist.Message="{Binding NodeEditor.Error}"><TextBlock Text="{l:Local NodeEditor.Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/><ScrollViewer Grid.Row="1" MaxHeight="430"><StackPanel Spacing="12"><TextBlock Text="{l:Tr a051}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{l:Tr a086}" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{l:Tr a240}" Classes="small" TextWrapping="Wrap"/><TextBox controls:FormAssist.Field="Name" Text="{Binding NodeEditor.Name}"/><TextBlock Text="{l:Tr a079}" Classes="small" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding NodeEditor.Protocols}" SelectedIndex="{Binding NodeEditor.ProtocolIndex}" HorizontalAlignment="Stretch"/><TextBlock Text="{l:Tr a214}" Classes="small" TextWrapping="Wrap"/><TextBox controls:FormAssist.Field="Port" Text="{Binding NodeEditor.Port}"/><CheckBox Content="{l:Tr workflow.metadata}" IsChecked="{Binding NodeEditor.MetadataOnly}"/><TextBlock IsVisible="{Binding NodeEditor.MetadataOnly}" Text="{l:Tr workflow.metadataHint}" Classes="small" TextWrapping="Wrap"/><StackPanel IsVisible="{Binding !NodeEditor.MetadataOnly}" Spacing="12">
      <TextBlock Text="{l:Tr protocols.credential}" Classes="small"/><controls:SecretTextBox controls:FormAssist.Field="Credential" Text="{Binding NodeEditor.Credential}" PasswordChar="●"/>
      <Button Content="{l:Tr protocols.generate}" Command="{Binding NodeEditor.GenerateCredentialCommand}" HorizontalAlignment="Left"/><StackPanel IsVisible="{Binding NodeEditor.RotationRequested}" Spacing="10"><TextBlock Text="重新生成会影响已有客户端连接，请更新导出配置。" TextWrapping="Wrap"/><WrapPanel><Button Content="{l:Tr v051.038}" Command="{Binding NodeEditor.ConfirmRotationCommand}" Margin="0,0,10,0"/><Button Content="{l:Tr v051.039}" Command="{Binding NodeEditor.CancelRotationCommand}"/></WrapPanel></StackPanel>
      <StackPanel IsVisible="{Binding NodeEditor.IsShadowsocks}" Spacing="8"><TextBlock Text="{l:Tr protocols.method}" Classes="small"/><ComboBox ItemsSource="{Binding NodeEditor.Methods}" SelectedItem="{Binding NodeEditor.Method}" HorizontalAlignment="Stretch"/></StackPanel>
      <StackPanel IsVisible="{Binding NodeEditor.IsCertificate}" Spacing="12"><CheckBox Content="{l:Tr acme.auto}" IsChecked="{Binding NodeEditor.AutomaticCertificate}"/><StackPanel IsVisible="{Binding NodeEditor.AutomaticCertificate}" Spacing="12"><TextBox controls:FormAssist.Field="AcmeEmail" Text="{Binding NodeEditor.AcmeEmail}" Watermark="{l:Tr acme.email}"/><ComboBox ItemsSource="{Binding NodeEditor.CertificateChallenges}" SelectedIndex="{Binding NodeEditor.AcmeChallengeIndex}"/><CheckBox IsChecked="{Binding NodeEditor.AcmeStaging}"><TextBlock Text="{l:Tr acme.staging}" TextWrapping="Wrap"/></CheckBox><CheckBox controls:FormAssist.Field="DomainAuthorized" IsChecked="{Binding NodeEditor.DomainAuthorized}"><TextBlock Text="{l:Tr acme.authorized}" TextWrapping="Wrap"/></CheckBox></StackPanel></StackPanel><StackPanel IsVisible="{Binding NodeEditor.ManualCertificate}" Spacing="8"><TextBlock Text="{l:Tr protocols.manualTls}" Classes="small" TextWrapping="Wrap"/><TextBox controls:FormAssist.Field="CertificatePath" Text="{Binding NodeEditor.CertificatePath}" Watermark="/etc/neko/cert.pem"/><TextBox Text="{Binding NodeEditor.CertificateKeyPath}" Watermark="/etc/neko/key.pem"/></StackPanel>
      <StackPanel IsVisible="{Binding NodeEditor.NeedsTls}" Spacing="8"><TextBlock Text="{l:Tr a015}" Classes="small"/><TextBox controls:FormAssist.Field="Sni" Text="{Binding NodeEditor.Sni}" Watermark="example.com"/></StackPanel>
      <StackPanel IsVisible="{Binding NodeEditor.IsReality}" Spacing="8"><TextBlock Text="{l:Tr a012}" Classes="small"/><TextBox Text="{Binding NodeEditor.RealityPublicKey}"/><TextBlock Text="Short ID" Classes="small"/><TextBox Text="{Binding NodeEditor.ShortId}"/><TextBlock Text="{l:Tr workflow.privateKey}" Classes="small"/><controls:SecretTextBox controls:FormAssist.Field="RealityPrivateKey" Text="{Binding NodeEditor.RealityPrivateKey}" PasswordChar="●"/><TextBlock Text="{l:Tr workflow.privateHint}" Classes="small" TextWrapping="Wrap"/></StackPanel>
      <TextBlock Text="{l:Tr protocols.secureSave}" Classes="small" TextWrapping="Wrap"/>
      <TextBlock Text="{l:Tr protocols.sensitive}" Classes="small" TextWrapping="Wrap"/><Button Content="{l:Tr protocols.serverFile}" Command="{Binding NodeEditor.SaveServerFileCommand}" HorizontalAlignment="Left"/>
    </StackPanel></StackPanel></ScrollViewer><StackPanel Grid.Row="2" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="{l:Tr a082}" Command="{Binding CancelNodeEditorCommand}"/><Button Content="{l:Tr a057}" Classes="primary" Command="{Binding SaveNodeCommand}"/></StackPanel></Grid></Border></controls:RevealBorder>
    <controls:RevealBorder Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource DimBrush}" IsShown="{Binding HasExporter}" ReduceMotion="{ReflectionBinding $parent[Window].DataContext.Settings.ReduceMotion}"><Border Width="620" Background="{DynamicResource DialogGlassBrush}" Padding="30" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid RowDefinitions="*,Auto"><ScrollViewer MaxHeight="430"><views:ExportView DataContext="{Binding Exporter}"/></ScrollViewer><Button Grid.Row="1" Content="{l:Tr a065}" HorizontalAlignment="Right" Margin="0,18,0,0" Command="{Binding CloseExporterCommand}"/></Grid></Border></controls:RevealBorder>
    <controls:RevealBorder Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource DimBrush}" IsShown="{Binding SshSecrets.IsOpen}" ReduceMotion="{Binding Settings.ReduceMotion}"><Border Background="{DynamicResource DialogGlassBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="30" MaxWidth="470" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="18"><TextBlock Text="{l:Local SshSecrets.Title}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding SshSecrets.Endpoint}" TextWrapping="Wrap"/><TextBlock Text="{l:Tr ssh.sessionOnly}" Classes="muted" TextWrapping="Wrap" LineHeight="25"/><controls:SecretTextBox Text="{Binding SshSecrets.Password}" PasswordChar="●"/><WrapPanel HorizontalAlignment="Right"><Button Content="{l:Tr a082}" Command="{Binding SshSecrets.CancelCommand}" Margin="0,0,12,0"/><Button Content="{l:Tr ssh.continue}" Command="{Binding SshSecrets.AcceptCommand}" Classes="primary"/></WrapPanel></StackPanel></Border></controls:RevealBorder>
    <controls:RevealBorder Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource DimBrush}" IsShown="{Binding HostTrust.IsOpen}" ReduceMotion="{Binding Settings.ReduceMotion}">
      <Border Margin="24" MaxWidth="520" Padding="30" Background="{DynamicResource DialogGlassBrush}" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><StackPanel Spacing="18">
        <TextBlock Text="{l:Tr remote.trustTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{l:Tr remote.trustBody}" Classes="muted" TextWrapping="Wrap" LineHeight="26"/>
        <TextBlock Text="{Binding HostTrust.Endpoint}" FontWeight="Medium" TextWrapping="Wrap"/><TextBlock Text="{Binding HostTrust.Algorithm}" Classes="small"/>
        <Border Background="{DynamicResource NoticeBrush}" Padding="16" CornerRadius="5"><TextBlock Text="{Binding HostTrust.Fingerprint}" FontFamily="Cascadia Mono, Consolas, monospace" TextWrapping="Wrap" FontSize="13"/></Border>
        <TextBlock Text="{l:Tr part2.fingerprintHelp}" Classes="small" TextWrapping="Wrap" LineHeight="23"/><TextBlock Text="{l:Tr remote.trustCache}" Classes="small" TextWrapping="Wrap"/>
        <WrapPanel HorizontalAlignment="Right"><Button Content="{l:Tr a082}" Command="{Binding HostTrust.CancelCommand}" Margin="0,0,12,8"/><Button Content="{l:Tr remote.trustAccept}" Classes="primary" Command="{Binding HostTrust.AcceptCommand}" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel></Border>
    </controls:RevealBorder>
    <Border Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding HasOnboarding}"><views:OnboardingView x:Name="OnboardingScreen" DataContext="{Binding Onboarding}"/></Border>
    <controls:RevealBorder Grid.Row="1" Grid.RowSpan="2" IsShown="{Binding IsExitSaveFailed}" Background="{DynamicResource DimBrush}" ReduceMotion="{ReflectionBinding $parent[Window].DataContext.Settings.ReduceMotion}"><Border Width="460" Background="{DynamicResource DialogGlassBrush}" Padding="28" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="18"><TextBlock Text="{l:Tr window.exitSaveFailure}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{l:Tr window.exitSaveFailureBody}" TextWrapping="Wrap" LineHeight="24"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="{l:Tr a082}" Command="{Binding CancelExitCommand}"/><Button Content="{l:Tr window.exitWithoutSaving}" Classes="danger" Command="{Binding ExitWithoutSavingCommand}"/></StackPanel></StackPanel></Border></controls:RevealBorder>
    <controls:RevealBorder Grid.Row="1" Grid.RowSpan="2" ZIndex="100" ToastMotion="True" IsShown="{Binding Toast.IsOpen}" ReduceMotion="{Binding Settings.ReduceMotion}" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="560" Margin="24,12">
      <controls:GlassPanel Background="{DynamicResource DialogGlassBrush}" Padding="18,14" CornerRadius="18"><Border Classes="toastAccent" Classes.error="{Binding Toast.IsError}" BorderThickness="3,0,0,0" Padding="12,0,0,0"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Classes="toastTitle" Classes.error="{Binding Toast.IsError}" Text="{l:Local Toast.Title}" FontWeight="SemiBold"/><TextBlock Text="{l:Local Toast.Message}" TextWrapping="Wrap" MaxWidth="430"/></StackPanel><Button Grid.Column="1" Content="×" AutomationProperties.Name="{l:Tr a065}" Command="{Binding Toast.DismissCommand}" Classes="quiet" Padding="8,0" MinHeight="28" Margin="10,0,0,0" VerticalAlignment="Top"/></Grid></Border></controls:GlassPanel>
    </controls:RevealBorder>
  </Grid>
</Window>
