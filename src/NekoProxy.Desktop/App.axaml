<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:NekoProxy.Desktop.Controls" x:Class="NekoProxy.Desktop.App" RequestedThemeVariant="Default">
  <Application.Resources><ResourceDictionary><ResourceDictionary.ThemeDictionaries>
<ResourceDictionary x:Key="Light">
<SolidColorBrush x:Key="PageBrush">#78F4F8FF</SolidColorBrush>
<SolidColorBrush x:Key="SidebarBrush">#46FFFFFF</SolidColorBrush>
<SolidColorBrush x:Key="SurfaceBrush">#E8FFFFFF</SolidColorBrush>
<SolidColorBrush x:Key="TextBrush">#1D2938</SolidColorBrush>
<SolidColorBrush x:Key="MutedBrush">#52657D</SolidColorBrush>
