<UserControl xmlns="https://github.com/avaloniaui" xmlns:l="using:NekoProxy.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NekoProxy.Desktop.ViewModels" xmlns:core="using:NekoProxy.Core" xmlns:controls="using:NekoProxy.Desktop.Controls" x:Class="NekoProxy.Desktop.Views.AdvancedView" x:DataType="vm:AdvancedViewModel">
 <Grid RowDefinitions="Auto,*">
  <StackPanel Margin="28,24,28,22" Spacing="12"><TextBlock Text="{l:Tr a306}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding Target}" Classes="muted"/><ComboBox ItemsSource="{Binding Categories}" SelectedIndex="{Binding CategoryIndex}" HorizontalAlignment="Left" MinWidth="200"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{l:Local .}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
  <ScrollViewer Grid.Row="1"><StackPanel Margin="28,0,28,28" Spacing="22">
   <StackPanel IsVisible="{Binding Security}" Spacing="20">
    <TextBlock Text="{l:Local InspectionSummary}" Classes="muted" TextWrapping="Wrap" LineHeight="25"/>
    <Button Content="{l:Tr v060.inspect}" Command="{Binding InspectSecurityCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" Classes="primary"/>
    <ItemsControl ItemsSource="{Binding Findings}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:SecurityFinding">
      <StackPanel Spacing="10" Margin="0,0,0,24"><Border Height="1" Background="{DynamicResource LineBrush}"/><TextBlock Text="{l:Local Area}" Classes="small"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{l:Local StateLabel}" Classes="small"/></Grid>
        <TextBlock Text="{l:Local Recommendation}" TextWrapping="Wrap" LineHeight="24"/>
        <Expander Header="{l:Tr v060.evidence}"><StackPanel Spacing="8"><TextBlock Text="{Binding CheckedAt}" Classes="small"/><SelectableTextBlock Text="{Binding Evidence}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" TextWrapping="Wrap"/></StackPanel></Expander>
      </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
   <StackPanel IsVisible="{Binding Services}" Spacing="18"><TextBlock Text="{l:Tr tools.serviceHint}" Classes="muted" TextWrapping="Wrap" LineHeight="25"/><WrapPanel IsEnabled="{Binding !IsBusy}"><Button Content="{l:Tr tools.start}" Command="{Binding RequestServiceCommand}" CommandParameter="Start" Margin="0,0,10,10"/><Button Content="{l:Tr tools.stop}" Command="{Binding RequestServiceCommand}" CommandParameter="Stop" Margin="0,0,10,10"/><Button Content="{l:Tr tools.restart}" Command="{Binding RequestServiceCommand}" CommandParameter="Restart" Margin="0,0,10,10"/><Button Content="{l:Tr tools.check}" Command="{Binding RequestServiceCommand}" CommandParameter="CheckConfiguration" Margin="0,0,10,10"/><Button Content="{l:Tr tools.logs}" Command="{Binding RequestServiceCommand}" CommandParameter="RecentLogs" Margin="0,0,10,10"/><Button Content="{l:Tr tools.certificate}" Command="{Binding RequestServiceCommand}" CommandParameter="Certificate" Margin="0,0,10,10"/></WrapPanel></StackPanel>
   <StackPanel IsVisible="{Binding Environment}" Spacing="18"><TextBlock Text="{l:Tr tools.connectionHint}" Classes="muted" TextWrapping="Wrap" LineHeight="25"/><WrapPanel IsEnabled="{Binding !IsBusy}"><Button Content="{l:Tr tools.environment}" Command="{Binding RequestServiceCommand}" CommandParameter="Environment" Margin="0,0,12,10"/><Button Content="{l:Tr tools.sshTest}" Command="{Binding SshTestCommand}" Margin="0,0,12,10"/></WrapPanel><Grid ColumnDefinitions="160,Auto"><TextBox Text="{Binding TcpPort}" Watermark="TCP port"/><Button Grid.Column="1" Content="{l:Tr tools.tcpTest}" Command="{Binding TcpTestCommand}" Margin="12,0,0,0" IsEnabled="{Binding !IsBusy}"/></Grid></StackPanel>
   <StackPanel IsVisible="{Binding Terminal}" Spacing="16"><TextBlock Text="{l:Tr tools.terminalHint}" Classes="muted" TextWrapping="Wrap" LineHeight="25"/><WrapPanel><Button Content="{l:Tr tools.connectTerminal}" Command="{Binding ConnectTerminalCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,12,10"/><Button Content="{l:Tr tools.disconnect}" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" Margin="0,0,12,10"/><Button Content="Ctrl+C" Command="{Binding InterruptCommand}" IsEnabled="{Binding IsConnected}" Margin="0,0,12,10"/></WrapPanel><TextBox Text="{Binding TerminalText}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13" TextWrapping="Wrap" MinHeight="280" MaxHeight="430"/><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding TerminalInput}" IsEnabled="{Binding IsConnected}" Watermark="{l:Tr tools.inputHint}"/><Button Grid.Column="1" Content="{l:Tr tools.send}" Command="{Binding SendCommand}" IsEnabled="{Binding IsConnected}" Margin="12,0,0,0"/></Grid></StackPanel>
   <controls:RevealBorder IsShown="{Binding HasConfirmation}" controls:FormAssist.Reveal="{Binding HasConfirmation}" ReduceMotion="{ReflectionBinding $parent[Window].DataContext.Settings.ReduceMotion}"><Border Background="{DynamicResource SelectedBrush}" CornerRadius="7" Padding="22" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><StackPanel Spacing="16"><TextBlock Text="{l:Local ConfirmationText}" TextWrapping="Wrap"/><WrapPanel><Button Content="{l:Tr a082}" Command="{Binding CancelConfirmationCommand}" Margin="0,0,12,0"/><Button Content="{l:Local ConfirmButtonLabel}" Command="{Binding ConfirmCommand}" Classes="primary"/></WrapPanel></StackPanel></Border></controls:RevealBorder>
   <Border IsVisible="{Binding !Security}" Height="1" Background="{DynamicResource LineBrush}"/><TextBox IsVisible="{Binding !Security}" Text="{l:Local Result}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="480"/><Button IsVisible="{Binding IsBusy}" Content="{l:Tr remote.cancel}" Command="{Binding CancelOperationCommand}" HorizontalAlignment="Left"/>
   <Button Content="{l:Tr tools.localPrivacy}" Command="{ReflectionBinding $parent[Window].DataContext.NavigateCommand}" CommandParameter="隐私" HorizontalAlignment="Left" Classes="quiet"/>
  </StackPanel></ScrollViewer>
 </Grid>
</UserControl>
