<UserControl xmlns="https://github.com/avaloniaui" xmlns:l="using:NekoProxy.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NekoProxy.Desktop.ViewModels" xmlns:core="using:NekoProxy.Core" x:Class="NekoProxy.Desktop.Views.NetworkDiagnosticsView" x:DataType="vm:NetworkDiagnosticsViewModel">
  <UserControl.Resources><DataTemplate x:Key="ProbeTemplate" x:DataType="core:NetworkProbeResult">
<Expander Margin="0,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Expander.Header><StackPanel Spacing="7"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:Local Label}" FontWeight="Medium"/><TextBlock Grid.Column="1" Text="{l:Local StateLabel}" Foreground="{DynamicResource AccentInkBrush}" Margin="20,0,0,0"/></Grid><TextBlock Text="{l:Local Timing}" Classes="small" TextWrapping="Wrap"/></StackPanel></Expander.Header><StackPanel Spacing="10" Margin="0,12,0,16"><TextBlock Text="{l:Local Timing}"/><TextBlock Text="{l:Local SourceLabel}" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{l:Local Evidence}" Classes="muted" TextWrapping="Wrap" LineHeight="24"/></StackPanel></Expander>
</DataTemplate></UserControl.Resources>
  <StackPanel Spacing="22">
    <StackPanel Spacing="8"><TextBlock Text="{l:Tr v051.000}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{l:Tr v051.013}" Classes="muted" TextWrapping="Wrap"/></StackPanel>
    <TextBox Text="{Binding Domain}" Watermark="{l:Tr v051.017}" IsEnabled="{Binding !IsBusy}"/>
    <WrapPanel><Button Content="{l:Tr v051.005}" Command="{Binding RunCommand}" Classes="primary" IsEnabled="{Binding !IsBusy}" Margin="0,0,12,8"/><Button Content="{l:Tr v051.007}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Margin="0,0,12,8"/><Button Content="{l:Tr v051.006}" Command="{Binding CopySummaryCommand}" Margin="0,0,0,8"/></WrapPanel>
    <Border Classes="notice" Padding="18"><TextBlock Text="{l:Local Overview}" TextWrapping="Wrap" LineHeight="26"/></Border><TextBlock Text="{l:Tr v052.evidenceHint}" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{l:Local Status}" Foreground="{DynamicResource AccentInkBrush}" TextWrapping="Wrap"/>
    <Border Classes="notice" Padding="18"><TextBlock Text="{l:Local ExternalNotice}" Classes="muted" TextWrapping="Wrap" LineHeight="24"/></Border>
    <StackPanel Spacing="8"><TextBlock Text="{l:Tr v051.008}" Classes="section"/><TextBlock Text="{l:Tr v051.014}" Classes="small" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Inbound}" ItemTemplate="{StaticResource ProbeTemplate}"/></StackPanel>
    <StackPanel Spacing="8" Margin="0,10,0,0"><TextBlock Text="{l:Tr v051.009}" Classes="section"/><TextBlock Text="{l:Tr v051.015}" Classes="small" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Outbound}" ItemTemplate="{StaticResource ProbeTemplate}"/></StackPanel>
    <StackPanel Spacing="8" Margin="0,10,0,0"><TextBlock Text="{l:Tr v051.010}" Classes="section"/><ItemsControl ItemsSource="{Binding Configuration}" ItemTemplate="{StaticResource ProbeTemplate}"/></StackPanel>
    <Expander Header="{l:Tr v051.011}"><StackPanel Spacing="12"><Button Content="{l:Tr v051.012}" Command="{Binding RefreshConnectionCommand}" HorizontalAlignment="Left"/><TextBox Text="{Binding ConnectionDetail}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"/></StackPanel></Expander>
  </StackPanel>
</UserControl>
