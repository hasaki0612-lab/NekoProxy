<UserControl xmlns="https://github.com/avaloniaui" xmlns:l="using:NekoProxy.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NekoProxy.Desktop.ViewModels" xmlns:controls="using:NekoProxy.Desktop.Controls" x:Class="NekoProxy.Desktop.Views.MonitoringView" x:DataType="vm:MonitoringViewModel">
 <StackPanel Spacing="12">
  <WrapPanel><ComboBox ItemsSource="{Binding Intervals}" SelectedIndex="{Binding IntervalIndex}" MinWidth="135" Margin="0,0,12,10"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MonitorChoice"><TextBlock Text="{l:Local Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="{l:Tr monitor.start}" Command="{Binding StartCommand}" IsEnabled="{Binding !IsPolling}" Margin="0,0,10,10" Classes="primary"/><Button Content="{l:Tr monitor.pause}" Command="{Binding StopCommand}" IsEnabled="{Binding IsPolling}" Margin="0,0,10,10"/><Button Content="{l:Tr a074}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsSampling}" Margin="0,0,0,10"/></WrapPanel>
  <TextBlock Text="{Binding SystemSummary}" Classes="muted" TextWrapping="Wrap"/>
  <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0"><ComboBox ItemsSource="{Binding Metrics}" SelectedIndex="{Binding MetricIndex}" MinWidth="150" HorizontalAlignment="Left"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{l:Local .}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox Grid.Column="1" ItemsSource="{Binding Ranges}" SelectedIndex="{Binding RangeIndex}" MinWidth="115"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MonitorChoice"><TextBlock Text="{l:Local Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
  <controls:TimeSeriesChart Samples="{Binding Samples}" Metric="{Binding Metric}" RangeSeconds="{Binding RangeSeconds}" ReduceMotion="{ReflectionBinding $parent[Window].DataContext.Settings.ReduceMotion}"/>
  <TextBlock Text="{l:Tr monitor.chartHelp}" Classes="small" TextWrapping="Wrap" LineHeight="22"/>
  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:Tr monitor.localHistory}" Classes="small"/><TextBlock Grid.Column="1" Text="{Binding LastSample}" Classes="small"/></Grid>
  <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,10,0,10"/>
  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="14" ColumnSpacing="16"><StackPanel><TextBlock Text="{l:Tr monitor.systemUptime}" Classes="small"/><TextBlock Text="{l:Local SystemUptime}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{l:Tr monitor.sshTime}" Classes="small"/><TextBlock Text="{Binding ConnectionTime}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="{l:Tr monitor.memory}" Classes="small"/><TextBlock Text="{Binding MemoryUsage}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="{l:Tr monitor.disk}" Classes="small"/><TextBlock Text="{Binding DiskUsage}" Margin="0,7,0,0"/></StackPanel></Grid>
  <TextBlock Text="{l:Local Message}" Classes="small" TextWrapping="Wrap" LineHeight="22"/>
  <StackPanel IsVisible="{Binding HasCertificate}" Spacing="9" Margin="0,12,0,0"><Border Height="1" Background="{DynamicResource LineBrush}"/><TextBlock Text="{l:Tr monitor.certificate}" Classes="section" Margin="0,12,0,0"/><TextBlock Text="{l:Local Snapshot.Certificate.State}"/><TextBlock Text="{Binding Snapshot.Certificate.Domain}" Classes="muted"/><TextBlock Text="{Binding Snapshot.Certificate.ExpiresAt}" Classes="small"/><WrapPanel><TextBlock Text="{l:Tr monitor.remaining}" Classes="small" Margin="0,0,12,0"/><TextBlock Text="{Binding Snapshot.Certificate.RemainingDays}" Classes="small"/></WrapPanel><TextBlock Text="{Binding Snapshot.Certificate.Issuer}" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{l:Local Snapshot.Certificate.RenewalStatus}" Classes="small" TextWrapping="Wrap"/></StackPanel>
 </StackPanel>
</UserControl>
