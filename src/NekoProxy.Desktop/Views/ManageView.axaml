<UserControl xmlns="https://github.com/avaloniaui" xmlns:l="using:NekoProxy.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NekoProxy.Desktop.ViewModels" xmlns:core="using:NekoProxy.Core" xmlns:controls="using:NekoProxy.Desktop.Controls" xmlns:views="using:NekoProxy.Desktop.Views" x:Class="NekoProxy.Desktop.Views.ManageView" x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Margin="28,24,28,20" Spacing="7"><TextBlock Text="{l:Tr a230}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{l:Tr a231}" Classes="muted" TextWrapping="Wrap"/></StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="280,*">
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22,0,22,24">
          <Grid ColumnDefinitions="*,Auto" Margin="8,0,0,16"><StackPanel Spacing="5"><TextBlock Text="{l:Tr a170}" Classes="section" TextWrapping="Wrap"/><TextBlock Text="{l:Local ServerCount}" Classes="small" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="{l:Tr a308}" Classes="quiet" Command="{Binding AddServerCommand}"/></Grid>
          <TextBox Grid.Row="1" Watermark="{l:Tr a148}" Text="{Binding Search}" Margin="6,0,6,18"/>
          <ListBox Grid.Row="2" Classes="serverList" ItemsSource="{Binding FilteredServers}" SelectedItem="{Binding SelectedServer}"><ListBox.ItemTemplate><DataTemplate x:DataType="core:ServerProfile"><controls:ServerListItem/></DataTemplate></ListBox.ItemTemplate></ListBox>
          <StackPanel Grid.Row="2" IsVisible="{Binding ShowEmptyList}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><TextBlock Text="{l:Tr a196}" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="{l:Tr a203}" Classes="small" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Grid.Row="3" Spacing="8"><Border Height="1" Background="{DynamicResource LineBrush}" Margin="6,12,6,6"/><TextBlock Text="{l:Tr a130}" Classes="small" Margin="8,0" TextWrapping="Wrap"/><TextBlock Text="{l:Tr a133}" Classes="small" Margin="8,0" TextWrapping="Wrap"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" IsVisible="{Binding HasSelection}" RowDefinitions="Auto,*"><WrapPanel Margin="32,0,32,10"><Button Content="{l:Tr monitor.overview}" Classes="category" Classes.selected="{Binding DetailOverview}" Command="{Binding SelectDetailCommand}" CommandParameter="0" Margin="0,0,12,8"/><Button Content="{l:Tr monitor.title}" Classes="category" Classes.selected="{Binding DetailMonitor}" Command="{Binding SelectDetailCommand}" CommandParameter="1" Margin="0,0,12,8"/><Button Content="{l:Tr v051.001}" Classes="category" Classes.selected="{Binding DetailNetwork}" Command="{Binding OpenNetworkCommand}" Margin="0,0,0,8"/></WrapPanel><controls:PageDeck Grid.Row="1" SelectedIndex="{Binding DetailIndex}" ReduceMotion="{Binding Settings.ReduceMotion}"><ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,0,36,30" Spacing="0">
          <StackPanel Spacing="6"><TextBlock Text="{Binding SelectedServer.Name}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><WrapPanel><Button Content="{l:Tr part2.editServer}" Classes="quiet" Command="{Binding EditServerCommand}" Margin="0,0,8,4"/><Button Content="{l:Tr a295}" Classes="quiet" Command="{Binding RenameServerCommand}" Margin="0,0,8,4"/><Button Content="{l:Tr a221}" Classes="quiet danger" Command="{Binding RequestRemoveCommand}" Margin="0,0,0,4"/></WrapPanel></StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,18,0,10"><TextBlock Text="{l:Tr part2.nodes}" Classes="section" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{l:Local NodeCount}" Classes="small" VerticalAlignment="Center"/></Grid>
          <ListBox Classes="serverList" ItemsSource="{Binding SelectedServer.Nodes}" SelectedItem="{Binding SelectedNode}" controls:FormAssist.Selection="{Binding SelectedNode}" MaxHeight="120"><ListBox.ItemTemplate><DataTemplate x:DataType="core:ProxyNode"><Grid ColumnDefinitions="*,Auto" Margin="12,8"><StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding EndpointSummary}" Classes="small" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="{l:Local DeploymentLabel}" Classes="small" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <WrapPanel Margin="0,10,0,10"><Button Content="{l:Tr v051.002}" Command="{Binding QuickDeployCommand}" Classes="primary" Margin="0,0,10,8"/><Button Content="{l:Tr part2.addExisting}" Command="{Binding AddNodeCommand}" Margin="0,0,10,8"/><Button Content="{l:Tr part2.editNode}" Command="{Binding EditNodeCommand}" IsEnabled="{Binding HasNode}" Margin="0,0,0,8"/></WrapPanel>
          <StackPanel IsVisible="{Binding HasNode}" Spacing="9" Margin="0,0,0,10"><TextBlock Text="{l:Local NodeConfigStatus}" TextWrapping="Wrap"/><TextBlock Text="{l:Local NodeRuntimeStatus}" TextWrapping="Wrap"/><TextBlock Text="{l:Local NodeClientEvidence}" TextWrapping="Wrap"/>
          <WrapPanel DataContext="{Binding Advanced}" x:DataType="vm:AdvancedViewModel" IsEnabled="{Binding !IsBusy}"><Button Content="{l:Tr part2.start}" Command="{Binding RequestServiceCommand}" CommandParameter="Start" Margin="0,4,8,4"/><Button Content="{l:Tr part2.stop}" Command="{Binding RequestServiceCommand}" CommandParameter="Stop" Margin="0,4,8,4"/><Button Content="{l:Tr part2.restart}" Command="{Binding RequestServiceCommand}" CommandParameter="Restart" Margin="0,4,8,4"/><Button Content="{l:Tr part2.logs}" Command="{Binding RequestServiceCommand}" CommandParameter="RecentLogs" Margin="0,4,8,4"/><Button Content="{l:Tr part2.checkConfig}" Command="{Binding RequestServiceCommand}" CommandParameter="CheckConfiguration" Margin="0,4,0,4"/></WrapPanel>
          <WrapPanel><Button Content="{l:Tr a208}" Classes="primary" Command="{Binding OpenExporterCommand}" Margin="0,4,10,4"/><Button Content="{l:Tr remote.deployNode}" Command="{Binding PrepareDeploymentCommand}" Margin="0,4,0,4"/></WrapPanel>
          </StackPanel>
          <StackPanel DataContext="{Binding Advanced}" x:DataType="vm:AdvancedViewModel"><controls:RevealBorder IsShown="{Binding HasConfirmation}" controls:FormAssist.Reveal="{Binding HasConfirmation}" ReduceMotion="{ReflectionBinding $parent[Window].DataContext.Settings.ReduceMotion}"><Border Classes="notice" Padding="18" Margin="0,8"><StackPanel Spacing="12"><TextBlock Text="{l:Local ConfirmationText}" TextWrapping="Wrap"/><WrapPanel><Button Content="{l:Tr a082}" Command="{Binding CancelConfirmationCommand}" Margin="0,0,10,0"/><Button Content="{l:Local ConfirmButtonLabel}" Command="{Binding ConfirmCommand}" Classes="primary"/></WrapPanel></StackPanel></Border></controls:RevealBorder>
          <Expander Header="{l:Tr part2.operationResult}" IsVisible="{Binding HasServiceResult}" IsExpanded="{Binding HasServiceResult}" Margin="0,8"><TextBox Text="{Binding Result}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="220" MinHeight="60"/></Expander></StackPanel>
          <Expander Header="{l:Tr part2.serverDetails}" Margin="0,18,0,0"><StackPanel>          <WrapPanel Margin="0,14,0,4"><Button Content="{l:Tr v051.002}" Command="{Binding QuickDeployCommand}" Classes="primary" Margin="0,0,10,8"/><Button Content="{l:Tr v051.003}" Command="{Binding OpenToolsCommand}" Margin="0,0,0,8"/></WrapPanel><Button Content="{l:Tr v051.004}" Command="{Binding DisconnectSshCommand}" Classes="quiet" HorizontalAlignment="Left" Margin="0,0,0,8"/><TextBlock Text="{Binding SelectedServer.Notes}" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,10" LineHeight="22"/>
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="7"><TextBlock Text="{l:Tr a061}" Classes="small" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding SelectedServer.Host}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Content="{l:Tr a099}" Classes="quiet" Padding="6,0" MinHeight="24" Command="{Binding CopyIpCommand}"/></StackPanel></StackPanel>
            <StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="{l:Tr a092}" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{l:Placeholder SelectedServer.Location}" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Row="1" Spacing="5" Margin="0,10,0,0"><TextBlock Text="{l:Tr a127}" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{l:Local SelectedServer.ProtocolSummary}" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5" Margin="0,10,0,0"><TextBlock Text="{l:Tr v051.lastSsh}" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{l:Local Snapshot.SshState}" Classes="muted" TextWrapping="Wrap"/></StackPanel>
          </Grid>
          <Border Height="1" Background="{DynamicResource LineBrush}"/>
          <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,8"><TextBlock Text="{l:Tr a174}" Classes="section" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="{l:Tr a074}" Command="{Binding RefreshCommand}"/></Grid>
          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
            <StackPanel Spacing="8"><TextBlock Text="sing-box" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{l:Local Snapshot.ServiceState}" FontSize="15" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{l:Tr a008}" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{Binding CpuDisplay}" FontSize="18" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Column="2" Spacing="8"><TextBlock Text="{l:Tr a068}" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{Binding MemoryDisplay}" FontSize="18" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0"><TextBlock Text="{l:Tr a175}" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{l:Local UptimeDisplay}" FontSize="15" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8" Margin="0,12,0,0"><TextBlock Text="{l:Tr a040}" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{Binding UploadDisplay}" FontSize="15" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="8" Margin="0,12,0,0"><TextBlock Text="{l:Tr a042}" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{Binding DownloadDisplay}" FontSize="15" TextWrapping="Wrap"/></StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12"><TextBlock Text="{l:Tr a166}" Classes="small" TextWrapping="Wrap"/><TextBlock Text="{l:Local LastRefresh}" Classes="small" TextWrapping="Wrap"/></StackPanel>
          <Border Height="1" Background="{DynamicResource LineBrush}"/>

</StackPanel></Expander>

        </StackPanel>
      </ScrollViewer><ScrollViewer HorizontalScrollBarVisibility="Disabled"><views:MonitoringView DataContext="{Binding Monitoring}" Margin="32,0,32,30"/></ScrollViewer><ScrollViewer HorizontalScrollBarVisibility="Disabled"><views:NetworkDiagnosticsView DataContext="{Binding Network}" Margin="32,0,32,30"/></ScrollViewer></controls:PageDeck></Grid>
      <StackPanel Grid.Column="1" IsVisible="{Binding NoSelection}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="390" Spacing="14">
        <Path Data="M3 4 H21 V10 H3 Z M3 14 H21 V20 H3 Z M6 7 H6.1 M6 17 H6.1" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.2" Width="40" Height="36" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
        <TextBlock Text="{l:Tr a046}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Text="{l:Tr a199}" Classes="muted" TextAlignment="Center" LineHeight="24" TextWrapping="Wrap"/>
        <Button Content="{l:Tr a200}" Classes="primary" Command="{Binding AddServerCommand}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <Button Content="{l:Tr a275}" Classes="quiet" Command="{Binding LoadExamplesCommand}" IsVisible="{Binding ShowWelcome}" HorizontalAlignment="Center"/>
        <TextBlock Text="{l:Tr a219}" Classes="small" HorizontalAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
