<UserControl xmlns="https://github.com/avaloniaui" xmlns:l="using:NekoProxy.Desktop.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NekoProxy.Desktop.ViewModels" xmlns:controls="using:NekoProxy.Desktop.Controls"  x:Class="NekoProxy.Desktop.Views.SettingsView" x:DataType="vm:SettingsViewModel"><Grid RowDefinitions="Auto,*,Auto"><StackPanel Margin="28,24,28,0" MaxWidth="860" HorizontalAlignment="Stretch"><TextBlock Text="{l:Tr a246}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/><WrapPanel Margin="0,22,0,18"><Button Classes="category" Classes.selected="{Binding Category0}" Content="{l:Tr category.appearance}" Command="{Binding SelectCategoryCommand}" CommandParameter="0" Margin="0,0,8,8"/><Button Classes="category" Classes.selected="{Binding Category1}" Content="{l:Tr category.connection}" Command="{Binding SelectCategoryCommand}" CommandParameter="1" Margin="0,0,8,8"/><Button Classes="category" Classes.selected="{Binding Category2}" Content="{l:Tr category.maintenance}" Command="{Binding SelectCategoryCommand}" CommandParameter="2" Margin="0,0,8,8"/><Button Classes="category" Classes.selected="{Binding Category3}" Content="{l:Tr category.application}" Command="{Binding SelectCategoryCommand}" CommandParameter="3" Margin="0,0,8,8"/></WrapPanel><Border Height="1" Background="{DynamicResource LineBrush}"/></StackPanel><controls:PageDeck Grid.Row="1" SelectedIndex="{Binding CategoryIndex}" ReduceMotion="{ReflectionBinding $parent[Window].DataContext.Settings.ReduceMotion}"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,24,28,24" MaxWidth="860" HorizontalAlignment="Stretch"><TextBlock Text="{l:Tr category.appearance}" Classes="section" Margin="0,0,0,18" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,*" Margin="0,12"><StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="{l:Tr a252}" FontWeight="Medium" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Stretch"/></StackPanel></Grid><Border Height="1" Background="{DynamicResource LineBrush}"/><Grid ColumnDefinitions="*,*" Margin="0,12"><StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="{l:Tr a225}" FontWeight="Medium" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><ComboBox ItemsSource="{Binding WindowSizes}" SelectedIndex="{Binding WindowPresetIndex}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:WindowSizeChoice"><TextBlock Text="{l:Local Label}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Grid><Border Height="1" Background="{DynamicResource LineBrush}"/><Grid ColumnDefinitions="*,*" Margin="0,12"><StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="{l:Tr category.motion}" FontWeight="Medium" TextWrapping="Wrap"/><TextBlock Text="{l:Tr category.motionHelp}" Classes="small" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><ToggleSwitch IsChecked="{Binding ReduceMotion}" OnContent="{l:Tr common.on}" OffContent="{l:Tr common.off}"/></StackPanel></Grid><Border Height="1" Background="{DynamicResource LineBrush}"/><Grid ColumnDefinitions="*,*" Margin="0,18"><StackPanel Margin="0,0,20,0"><TextBlock Text="{l:Tr visual.simple}" FontWeight="Medium" TextWrapping="Wrap"/><TextBlock Text="{l:Tr visual.simpleHelp}" Classes="small" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding SimplifiedVisuals}" OnContent="{l:Tr common.on}" OffContent="{l:Tr common.off}" HorizontalAlignment="Left" VerticalAlignment="Center"/></Grid><Border Height="1" Background="{DynamicResource LineBrush}"/><Grid ColumnDefinitions="*,*" Margin="0,12"><StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="{l:Tr a213}" FontWeight="Medium" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><ComboBox ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ThemeChoice"><TextBlock Text="{l:Local Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Grid><Border Height="1" Background="{DynamicResource LineBrush}"/></StackPanel></ScrollViewer><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,24,28,24" MaxWidth="860" HorizontalAlignment="Stretch"><TextBlock Text="{l:Tr category.connection}" Classes="section" Margin="0,0,0,18" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,*" Margin="0,12"><StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="{l:Tr a307}" FontWeight="Medium" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBox Text="{Binding ExportDirectory}"/></StackPanel></Grid><Border Height="1" Background="{DynamicResource LineBrush}"/><Grid ColumnDefinitions="*,*" Margin="0,12"><StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="{l:Tr a027}" FontWeight="Medium" TextWrapping="Wrap"/><TextBlock Text="{l:Tr settings.timeoutHelp}" Classes="small" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBox Text="{Binding Timeout}" MaxWidth="110" HorizontalAlignment="Left"/></StackPanel></Grid><Border Height="1" Background="{DynamicResource LineBrush}"/><Grid ColumnDefinitions="*,*" Margin="0,12"><StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="{l:Tr a048}" FontWeight="Medium" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Spacing="5"><TextBlock Text="sing-box 1.14.3"/><TextBlock Text="{l:Tr a089}" Classes="small" TextWrapping="Wrap"/></StackPanel></StackPanel></Grid><Border Height="1" Background="{DynamicResource LineBrush}"/></StackPanel></ScrollViewer><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,24,28,24" MaxWidth="860" HorizontalAlignment="Stretch"><TextBlock Text="{l:Tr category.maintenance}" Classes="section" Margin="0,0,0,18" TextWrapping="Wrap"/>
<Grid ColumnDefinitions="*,Auto" Margin="0,14"><StackPanel><TextBlock Text="{l:Tr updates.automatic}"/><TextBlock Text="{l:Tr updates.daily}" Classes="small" TextWrapping="Wrap" Margin="0,5,24,0"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding Updates.AutoCheck}" OnContent="{l:Tr common.on}" OffContent="{l:Tr common.off}"/></Grid>
<Border Height="1" Background="{DynamicResource LineBrush}"/>
<Grid ColumnDefinitions="*,*" Margin="0,18"><StackPanel Spacing="6"><TextBlock Text="{l:Tr updates.installed}" Classes="small"/><TextBlock Text="0.6.0"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{l:Tr updates.latest}" Classes="small"/><TextBlock Text="{Binding Updates.LatestVersion}"/></StackPanel></Grid>
<Grid ColumnDefinitions="*,*" Margin="0,0,0,22"><TextBlock Text="{l:Tr updates.checked}" Classes="small"/><TextBlock Grid.Column="1" Text="{Binding Updates.LastChecked}"/></Grid>
<Button Content="{l:Tr updates.check}" Command="{Binding Updates.CheckUpdatesCommand}" IsEnabled="{Binding !Updates.IsChecking}" HorizontalAlignment="Left"/>
<TextBlock Text="{l:Local Updates.Message}" TextWrapping="Wrap" Classes="muted" Margin="0,16"/>
<StackPanel IsVisible="{Binding Updates.HasUpdate}" Spacing="12"><TextBlock Text="{l:Tr updates.available}" FontWeight="SemiBold" TextWrapping="Wrap"/><WrapPanel><Button Content="{l:Tr updates.view}" Command="{Binding Updates.ViewReleaseCommand}" Margin="0,0,8,8"/><Button Content="{l:Tr updates.later}" Command="{Binding Updates.RemindLaterCommand}" Margin="0,0,8,8"/><Button Content="{l:Tr updates.ignore}" Command="{Binding Updates.IgnoreCommand}" Margin="0,0,8,8"/></WrapPanel></StackPanel></StackPanel></ScrollViewer><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,24,28,24" MaxWidth="860" HorizontalAlignment="Stretch"><TextBlock Text="{l:Tr category.application}" Classes="section" Margin="0,0,0,18" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,*" Margin="0,12"><StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="{l:Tr a302}" FontWeight="Medium" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="{l:Tr a298}" Command="{Binding RewatchCommand}" HorizontalAlignment="Left"/></StackPanel></Grid><Border Height="1" Background="{DynamicResource LineBrush}"/><Grid ColumnDefinitions="*,*" Margin="0,12"><StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="{l:Tr a064}" FontWeight="Medium" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="v0.6.0 · .NET 10 / Avalonia 11.3.22 · MIT License" Classes="muted" TextWrapping="Wrap"/></StackPanel></Grid><Border Height="1" Background="{DynamicResource LineBrush}"/><TextBlock Text="{l:Tr a274}" Classes="small" Margin="0,20" TextWrapping="Wrap"/><Button Content="{l:Tr a287}" Command="{Binding ExitCommand}" HorizontalAlignment="Left"/></StackPanel></ScrollViewer></controls:PageDeck><controls:ActionSurface Grid.Row="2"><Grid ColumnDefinitions="Auto,*" Margin="28,14"><Button Content="{l:Tr a059}" Classes="primary" Command="{Binding SaveCommand}"/><TextBlock Grid.Column="1" Text="{l:Local Message}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16,0,0,0"/></Grid></controls:ActionSurface></Grid></UserControl>