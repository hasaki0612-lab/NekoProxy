<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NekoProxy.Desktop.ViewModels" xmlns:tour="using:NekoProxy.Desktop.Onboarding" x:Class="NekoProxy.Desktop.Views.OnboardingView" x:DataType="vm:OnboardingViewModel" Background="{DynamicResource SolidBrush}" FontFamily="{Binding FontFamily}">
  <UserControl.Styles>
    <Style Selector="TextBlock.tourTitle"><Setter Property="FontSize" Value="40"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="LineHeight" Value="48"/><Setter Property="Foreground" Value="{DynamicResource TourPrimaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="TextAlignment" Value="Center"/></Style>
    <Style Selector="TextBlock.tourLead"><Setter Property="FontSize" Value="18"/><Setter Property="LineHeight" Value="28.8"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="TextAlignment" Value="Center"/></Style>
    <Style Selector="TextBlock.principleTitle"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TourPrimaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="24"/></Style>
    <Style Selector="TextBlock.principleDescription"><Setter Property="FontSize" Value="14.5"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23.2"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
    <Style Selector="Button.tourPrimary"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Height" Value="44"/><Setter Property="MinWidth" Value="120"/><Setter Property="Padding" Value="24,0"/><Setter Property="CornerRadius" Value="22"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="{DynamicResource TourPrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource TourPrimaryTextBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.tourPrimary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource TourPrimaryHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TourPrimaryTextBrush}"/></Style>
    <Style Selector="Button.tourGhost"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Height" Value="44"/><Setter Property="MinWidth" Value="96"/><Setter Property="Padding" Value="24,0"/><Setter Property="CornerRadius" Value="22"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
    <Style Selector="Button.tourLink"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="CornerRadius" Value="20"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="12,8"/></Style>
    <Style Selector="Button.tourDot"><Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="MinHeight" Value="8"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Transitions"><Transitions><DoubleTransition Property="Width" Duration="0:0:0.3"><DoubleTransition.Easing><tour:PrototypeEasing/></DoubleTransition.Easing></DoubleTransition><BrushTransition Property="Background" Duration="0:0:0.3"><BrushTransition.Easing><tour:PrototypeEasing/></BrushTransition.Easing></BrushTransition></Transitions></Setter></Style>
    <Style Selector="Button.tourDot.active"><Setter Property="Width" Value="24"/><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="ListBox.languages"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="ListBox.languages ListBoxItem"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="5"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/></Style>
    <Style Selector="ListBox.languages ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBox.languages ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Style>
    <Style Selector="ListBox.languages TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
    <Style Selector="ListBox.languages ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/></Style>
    <Style Selector="ListBox.languages ListBoxItem /template/ ContentPresenter"><Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.18"><BrushTransition.Easing><tour:PrototypeEasing/></BrushTransition.Easing></BrushTransition></Transitions></Setter></Style>
    <Style Selector="Path.languageCheck"><Setter Property="Opacity" Value="0"/><Setter Property="RenderTransform" Value="translateX(-4px)"/><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18"><DoubleTransition.Easing><tour:PrototypeEasing/></DoubleTransition.Easing></DoubleTransition><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"><TransformOperationsTransition.Easing><tour:PrototypeEasing/></TransformOperationsTransition.Easing></TransformOperationsTransition></Transitions></Setter></Style>
    <Style Selector="ListBoxItem:selected Path.languageCheck"><Setter Property="Opacity" Value="1"/><Setter Property="RenderTransform" Value="translateX(0px)"/></Style>
    <Style Selector="UserControl.reduced Button.tourDot"><Setter Property="Transitions"><Transitions/></Setter></Style>
    <Style Selector="UserControl.reduced Path.languageCheck"><Setter Property="Transitions"><Transitions/></Setter></Style>
    <Style Selector="UserControl.reduced ListBox.languages ListBoxItem /template/ ContentPresenter"><Setter Property="Transitions"><Transitions/></Setter></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="56,*,84">
    <Grid ColumnDefinitions="*,Auto" Margin="28,0"><TextBlock Text="NekoProxy" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="SkipButton" Content="{Binding Text[skip]}" Classes="tourLink" Command="{Binding SkipCommand}" IsEnabled="{Binding CanNavigate}" Margin="0,0,-12,0"/></Grid>
    <Grid x:Name="Stage" Grid.Row="1" ClipToBounds="True">
      <ScrollViewer x:Name="WelcomePage" HorizontalScrollBarVisibility="Disabled">
        <Border MinHeight="{Binding #Stage.Bounds.Height}" Padding="40,24"><StackPanel MaxWidth="880" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <tour:WelcomeMotif x:Name="Motif" HorizontalAlignment="Center" Margin="0,0,0,36"/>
          <!-- Automatic font metrics preserve descenders in mixed CJK/Latin fallback fonts. -->
          <TextBlock x:Name="WelcomeTitle" Text="{Binding Text[welcomeTitle]}" Classes="tourTitle" LineHeight="NaN" Padding="0,0,0,4"/>
          <TextBlock Text="{Binding Text[welcomeLead]}" Classes="tourLead" Margin="0,14,0,0"/>
          <StackPanel Width="360" HorizontalAlignment="Center" Margin="0,28,0,0"><TextBlock Text="{Binding Text[languageHeading]}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
            <ListBox x:Name="LanguageList" Classes="languages" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding Text[languageHeading]}"><ListBox.ItemTemplate><DataTemplate x:DataType="tour:LanguageChoice"><Grid ColumnDefinitions="*,16"><TextBlock Text="{Binding Name}" FontFamily="{Binding FontFamily}" FontSize="15"/><Viewbox Grid.Column="1" Width="16" Height="16"><Canvas Width="20" Height="20"><Path Classes="languageCheck" Data="M4 10 L8 14 L16 6" Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          </StackPanel>
        </StackPanel></Border>
      </ScrollViewer>
      <ScrollViewer x:Name="ConnectionPage" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
        <Border MinHeight="{Binding #Stage.Bounds.Height}" Padding="40,24"><StackPanel MaxWidth="880" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <TextBlock Text="{Binding Text[howTitle]}" Classes="tourTitle"/>
          <TextBlock Text="{Binding Text[howLead]}" Classes="tourLead" Margin="0,14,0,0"/>
          <StackPanel MaxWidth="800" HorizontalAlignment="Stretch" Margin="0,52,0,0">
            <Viewbox Stretch="Uniform"><tour:ConnectionDiagram x:Name="Connection"/></Viewbox>
            <Grid ColumnDefinitions="3*,4*,3*" Margin="0,8,0,0"><TextBlock x:Name="LocalLabel" Text="{Binding Text[localLabel]}" Foreground="{DynamicResource MutedBrush}" FontSize="15" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Grid.Column="1" x:Name="SshLabel" Text="{Binding Text[sshLabel]}" Foreground="{DynamicResource MutedBrush}" FontSize="15" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Grid.Column="2" x:Name="VpsLabel" Text="{Binding Text[vpsLabel]}" Foreground="{DynamicResource MutedBrush}" FontSize="15" TextAlignment="Center" TextWrapping="Wrap"/></Grid>
          </StackPanel>
          <TextBlock x:Name="Caption" Text="{Binding Caption}" FontSize="14" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22.4" MinHeight="22" Margin="0,26,0,0"/>
          <Button Classes="tourLink" Command="{Binding ReplayCommand}" HorizontalAlignment="Center" FontSize="13" Margin="0,10,0,0" Padding="12,6"><StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M3 12a9 9 0 1 0 3-6.7 M3 4v5h5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><TextBlock Text="{Binding Text[replay]}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Button>
        </StackPanel></Border>
      </ScrollViewer>
      <ScrollViewer x:Name="PrivacyPage" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
        <Border MinHeight="{Binding #Stage.Bounds.Height}" Padding="40,24"><StackPanel MaxWidth="880" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <TextBlock Text="{Binding Text[privacyTitle]}" Classes="tourTitle"/>
          <StackPanel Width="560" HorizontalAlignment="Center" Margin="0,40,0,0">
            <Grid ColumnDefinitions="44,*" Margin="0,22"><Viewbox Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"><Canvas Width="24" Height="24"><Path Data="M4 14.5 6.6 6.7A2 2 0 0 1 8.5 5.3h7a2 2 0 0 1 1.9 1.4L20 14.5 M6 14.5H18A2 2 0 0 1 20 16.5V18A2 2 0 0 1 18 20H6A2 2 0 0 1 4 18V16.5A2 2 0 0 1 6 14.5 M8 17.3h.01" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding Text[localTitle]}" Classes="principleTitle"/><TextBlock Text="{Binding Text[localDescription]}" Classes="principleDescription"/></StackPanel></Grid>
            <Border Height="1" Background="{DynamicResource LineBrush}"/>
            <Grid ColumnDefinitions="44,*" Margin="0,22"><Viewbox Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"><Canvas Width="24" Height="24"><Path Data="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z M4 4l16 16" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding Text[accountTitle]}" Classes="principleTitle"/><TextBlock Text="{Binding Text[accountDescription]}" Classes="principleDescription"/></StackPanel></Grid>
            <Border Height="1" Background="{DynamicResource LineBrush}"/>
            <Grid ColumnDefinitions="44,*" Margin="0,22"><Viewbox Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"><Canvas Width="24" Height="24"><Path Data="M11.4 16.2a3.6 3.6 0 1 1 -7.2 0a3.6 3.6 0 1 1 7.2 0 M10.4 13.6 20 4 M16.4 7.6l2.6 2.6 M13.6 10.4l1.8 1.8" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding Text[credentialsTitle]}" Classes="principleTitle"/><TextBlock Text="{Binding Text[credentialsDescription]}" Classes="principleDescription"/></StackPanel></Grid>
            <Border Height="1" Background="{DynamicResource LineBrush}"/>
            <Grid ColumnDefinitions="44,*" Margin="0,22"><Viewbox Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"><Canvas Width="24" Height="24"><Path Data="M12 22v-5 M9 8V2 M15 8V2 M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding Text[connectionTitle]}" Classes="principleTitle"/><TextBlock Text="{Binding Text[connectionDescription]}" Classes="principleDescription"/></StackPanel></Grid>
          </StackPanel>
        </StackPanel></Border>
      </ScrollViewer>
    </Grid>
    <Border x:Name="Navigation" Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="*,Auto,*" Margin="28,0"><Button x:Name="PreviousButton" Content="{Binding Text[previous]}" Classes="tourGhost" Command="{Binding PreviousCommand}" IsVisible="{Binding CanBack}" IsEnabled="{Binding CanNavigate}" HorizontalAlignment="Left" VerticalAlignment="Center"/><StackPanel x:Name="Dots" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Button x:Name="Dot0" Classes="tourDot active" Command="{Binding GoToCommand}" CommandParameter="0"/><Button x:Name="Dot1" Classes="tourDot" Command="{Binding GoToCommand}" CommandParameter="1"/><Button x:Name="Dot2" Classes="tourDot" Command="{Binding GoToCommand}" CommandParameter="2"/></StackPanel><Button Grid.Column="2" x:Name="NextButton" Content="{Binding NextLabel}" Classes="tourPrimary" Command="{Binding NextCommand}" IsEnabled="{Binding CanNavigate}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
    <Border x:Name="DonePanel" Grid.RowSpan="3" Background="{DynamicResource ContentGlassBrush}" IsVisible="False" Padding="40"><StackPanel MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding DoneTitle}" FontSize="32" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TourPrimaryBrush}"/><TextBlock Text="{Binding Text[doneDescription]}" Classes="tourLead" FontSize="16" Margin="0,12,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,28,0,0"><Button x:Name="DismissButton" Classes="tourPrimary" Content="{Binding Text[start]}" Command="{Binding DismissCommand}"/><Button Classes="tourGhost" Content="{Binding Text[rewatch]}" Command="{Binding RewatchCommand}"/></StackPanel></StackPanel></Border>
    <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Top" TextWrapping="Wrap" MaxWidth="640"/>
  </Grid>
</UserControl>
